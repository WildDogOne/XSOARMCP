# XSOAR API credentials. Settings -> Integrations -> API Keys in your XSOAR/Cortex Cloud tenant.
XSOAR_FQDN=
XSOAR_API_KEY=
XSOAR_API_KEY_ID=

# "standard" or "advanced", matching whichever type you picked when generating the key above.
# Defaults to advanced if unset.
XSOAR_API_KEY_TYPE=advanced

# Optional: comma-separated toolsets to enable (incidents, indicators, investigations, reports,
# content, admin), or "all". Defaults to all.
XSOAR_TOOLSETS=all

# Optional: "true" drops every mutating tool, regardless of toolset. Defaults to false.
XSOAR_READ_ONLY=false
